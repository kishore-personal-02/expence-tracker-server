# PRODUCTION — used when NODE_ENV=production (Vercel sets this for you).
# Safe to commit: no secrets below.
NODE_ENV=production
PORT=5000

API_MOUNT=/api

# Empty = allow any origin.
# Lock it down by listing your client host, e.g. https://my-app.vercel.app
CLIENT_ORIGINS=

# Only used if you serve the built client from this same server.
CLIENT_DIST=../expense-tracker-client/dist
CLIENT_BASE=/

# Set these in your host's dashboard (Vercel > Settings > Environment
# Variables). Do NOT commit them here.
#   MONGO_URI   = your MongoDB Atlas connection string
#   JWT_SECRET  = node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
